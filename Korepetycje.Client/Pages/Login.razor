@page "/login"
@layout AuthLayout

<RadzenStack  Gap="2.5rem" >
    <RadzenStack  AlignItems="AlignItems.Center">
    <RadzenImage Path="https://www.radzen.com/images/logo.png" Style="width: 10rem;" AlternateText="url image" />
    </RadzenStack >

    @if (mode == "login")
    {

        <RadzenTemplateForm  TItem="LoginModel" Data="@loginModel" Submit="@OnLogin">
            <RadzenStack Gap="1rem">
                <RadzenSelectBar @bind-Value="@mode" TValue="string" Style="width: 100%;">
                    <Items>
                        <RadzenSelectBarItem Text="Logowanie" Value="@("login")" Style="flex: 1;" />
                        <RadzenSelectBarItem Text="Rejestracja" Value="@("register")" Style="flex: 1;" />
                    </Items>
                </RadzenSelectBar>
                <RadzenStack Gap="0.25rem">
                    <RadzenFormField Text="E-mail" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="loginModel.Email" Name="Email" />
                    </RadzenFormField>
                    <RadzenEmailValidator Component="Email" Text="Podaj poprawny adres e-mail" Popup="true" Style="position:relative; width:fit-content " />
                    <RadzenRequiredValidator Component="Email" Text="E-mail jest wymagan" Popup="true" Style="position:relative; width:fit-content " />
                </RadzenStack>
                <RadzenStack Gap="0.25rem">
                    <RadzenFormField Text="Hasło" Variant="Variant.Outlined">
                        <RadzenPassword @bind-Value="loginModel.Password" Name="Password" />
                    </RadzenFormField>
                    <RadzenRequiredValidator Component="Password" Text="Hasło jest wymagane" Popup="true" Style="position:relative; width:fit-content " />
                </RadzenStack>
                <RadzenButton ButtonType="ButtonType.Submit" Disabled="@isLoading" Click="OnLogin" Text="Zaloguj się" Style="width: 100%; margin-top: 0.5rem;" />
            </RadzenStack>
        </RadzenTemplateForm>
    }
    else
    {
        <RadzenTemplateForm @ref="form" TItem="RegisterModel" Data="@registerModel" Submit="@OnRegister">


            @if (step == 1)
            {
                <RadzenStack Gap="1rem">
                    <RadzenSelectBar @bind-Value="@mode" TValue="string" Style="width: 100%;">
                        <Items>
                            <RadzenSelectBarItem Text="Logowanie" Value="@("login")" Style="flex: 1;" />
                            <RadzenSelectBarItem Text="Rejestracja" Value="@("register")" Style="flex: 1;" />
                        </Items>
                    </RadzenSelectBar>
                    <RadzenStack Gap="0.25rem">
                        <RadzenFormField Text="Imię" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="registerModel.Name" Name=Name" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="Name" Text="Imie jest wymagane" Popup="true" Style="position:relative; width:fit-content " />
                    </RadzenStack>
                    <RadzenStack Gap="0.25rem">
                        <RadzenFormField Text="Nazwisko" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="registerModel.LastName" Name="LastName" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="LastName" Text="Nazwisko jest wymagane" Popup="true" Style="position:relative; width:fit-content " />
                    </RadzenStack>
                    <RadzenButton  Click="@Dalej" Text="Dalej" Style="width: 100%; margin-top: 0.5rem;" />
                </RadzenStack>
            }
            else if (step == 2)
            {
                <RadzenStack class="step-animated" Gap="1rem">
                    <RadzenSelectBar @bind-Value="@registerModel.RodzajKonta" TValue="int" Style="width: 100%;">
                        <Items>
                            <RadzenSelectBarItem Text="Korepetytor" Value="@(0)" Style="flex: 1;" />
                            <RadzenSelectBarItem Text="Rodzic/Uczeń" Value="@(1)" Style="flex: 1;" />
                        </Items>
                    </RadzenSelectBar>
                    <RadzenStack Gap="0.25rem">
                        <RadzenFormField Text="E-mail" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="registerModel.Email" Name="Email" />
                        </RadzenFormField>
                        <RadzenEmailValidator Component="Email" Text="Podaj poprawny adres e-mail" Popup="true" Style="position:relative; width:fit-content " />
                        <RadzenRequiredValidator Component="Email" Text="E-mail jest wymagan" Popup="true" Style="position:relative; width:fit-content " />
                    </RadzenStack>
                    <RadzenStack Gap="0.25rem">
                        <RadzenFormField Text="Hasło" Variant="Variant.Outlined">
                            <RadzenPassword @bind-Value="registerModel.Password" Name="Password" />
                        </RadzenFormField>
                        <RadzenRegexValidator Component="Password" 
                      Text="Hasło musi mieć min. 8 znaków, zawierać wielką literę, cyfrę i znak specjalny." 
                        Pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&._\-#+])[A-Za-z\d@@$!%*?&._\-#+]{8,}$" 
                                              Style="position:relative; width:fit-content " Popup="true" />
                        <RadzenRequiredValidator Component="Password" Text="Hasło jest wymagane" Popup="true" Style="position:relative; width:fit-content " />
                    </RadzenStack>
                    <RadzenStack Gap="1rem" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" >
                        <RadzenButton Click="@Cofinj" Text="Wstecz" Style="width: 50%; margin-top: 0.5rem;" />
                        <RadzenButton ButtonType="ButtonType.Submit" Disabled="@isLoading" Text="Utwórz konto" Style="width: 50%; margin-top: 0.5rem;" />
                    </RadzenStack>
                </RadzenStack>
            }

        </RadzenTemplateForm>
    }
</RadzenStack>


@inject HttpClient Http
@inject NavigationManager Navigation
@inject NotificationService notificationService

    @code {
    private RadzenTemplateForm<RegisterModel> form;
    private string mode = "login";
    private LoginModel loginModel = new();
    private RegisterModel registerModel = new();
    private int step = 1;
    // Flaga wskazująca, czy trwa proces logowania lub rejestracji służąca do wyłączenia przycisków podczas oczekiwania na odpowiedź z serwera
    private bool isLoading = false;
    
    private void Dalej()
    {

        if (form.EditContext != null && form.EditContext.Validate())
        {
            step++;
        }

             
    }
    private void Cofinj()
    {
        step--;
    }

    // Metoda obsługująca logowanie
    private async Task OnLogin()
    {
        isLoading = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                // Logowanie zakończone sukcesem, wyświetlenie powiadomienia i przekierowanie na stronę główną
                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Sukces",
                    Detail = "Zalogowano pomyślnie!",
                    Duration = 3000
                });
                await Task.Delay(500);
                Navigation.NavigateTo("/");
            }
            else
            {
                // Logowanie nie powiodło się, wyświetlenie powiadomienia z komunikatem o błędzie
                var errorResult = await response.Content.ReadFromJsonAsync<ErrorResponseDto>();
                string message = errorResult?.Message ?? "Nieprawidłowy e-mail lub hasło.";

                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Błąd logowania",
                    Detail = message,
                    Duration = 4000
                });
            }
        }
        catch (Exception ex) // Obsługa wyjątków, np. brak połączenia z serwerem
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Błąd połączenia",
                Detail = "Nie udało się połączyć z serwerem API.",
                Duration = 4000
            });
            Console.WriteLine($"Błąd podczas logowania: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    // Metoda obsługująca rejestrację
    private async Task OnRegister()
    {
        isLoading = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/register", registerModel);

            if (response.IsSuccessStatusCode)
            {
                // Rejestracja zakończona sukcesem, wyświetlenie powiadomienia i przejście do trybu logowania
                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Sukces",
                    Detail = "Konto zostało utworzone! Możesz się teraz zalogować.",
                    Duration = 4000
                });

                mode = "login";
                step = 1;
            }
            else
            {
                // Rejestracja nie powiodła się, wyświetlenie powiadomienia z komunikatem o błędzie
                var errorResult = await response.Content.ReadFromJsonAsync<ErrorResponseDto>();
                string message = errorResult?.Message ?? "Wystąpił błąd podczas rejestracji.";

                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Błąd rejestracji",
                    Detail = message,
                    Duration = 4000
                });
            }
        }
        catch (Exception ex) // Obsługa wyjątków, np. brak połączenia z serwerem
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Błąd połączenia",
                Detail = "Nie udało się połączyć z serwerem API.",
                Duration = 4000
            });
            Console.WriteLine($"Błąd podczas rejestracji: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private class ErrorResponseDto
    {
        public string Message { get; set; } = string.Empty;
    }

    public class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class RegisterModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public int RodzajKonta { get; set; } = 0;
    }
}