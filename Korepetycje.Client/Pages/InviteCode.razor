@page "/InviteCode"
@layout AuthLayout
@inject TooltipService tooltipService

<RadzenStack Gap="2.5rem" AlignItems="AlignItems.Center">
    <RadzenText TextStyle="TextStyle.DisplayH4" style="color: var(--rz-link-hover-color)" TextAlign="TextAlign.Center">Podaj kod otrzymany od korepetytora <RadzenIcon Icon="info" Style="font-size: 1rem"
                                                        MouseEnter="@(args => ShowTooltip(args) )"
                                                        MouseLeave="@(args => tooltipService.Close())" />
    </RadzenText>
    
    <RadzenTemplateForm TItem="InviteModel" Data="@inviteModel" Submit="@PrzypisywanieUczniaDoKorepetytora">
       <RadzenStack Gap="1rem" AlignItems="AlignItems.Center">
            <RadzenStack Gap="0.25rem">
        <RadzenFormField Text="Kod" Variant="Variant.Outlined">
            <RadzenTextBox @bind-Value="inviteModel.KodZaproszenia" Name="Kod" />
        </RadzenFormField>
        <RadzenRequiredValidator Component="Kod" Text="Kod jest wymagany aby przejsc dalej" Popup="true" Style="position:relative; width:fit-content" />
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit">Dalej</RadzenButton>
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenStack>

@code {
    private string Opis = "Wymagany, unikalny kod zaproszenia otrzymywany od korepetytora, który łączy Twoje konto z właściwym korepetytorem i odblokowuje wspólny kalendarz, lekcje, czat oraz rozliczenia";
    void ShowTooltip(ElementReference elementReference, TooltipOptions? options = null)
    {
        var opcje = options ?? new TooltipOptions
        {
            Duration = null
            
        };
        opcje.Style = "background-color: var(--rz-text-h4-color); color: var(--rz-base);";
        tooltipService.Open(elementReference, Opis, opcje);
    }
    
    private InviteModel inviteModel = new();

    private void PrzypisywanieUczniaDoKorepetytora()
    {
        
    }

    public class InviteModel
    {
        public string KodZaproszenia { get; set; } = string.Empty;
    }
}